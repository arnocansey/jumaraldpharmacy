datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ENUMS
// ============================================================

enum RoleName {
  SUPER_ADMIN
  ADMIN
  PHARMACIST
  DOCTOR
  PATIENT
  CUSTOMER
  BRANCH_MANAGER
  DELIVERY_DRIVER
  INVENTORY_CLERK
}

enum OrderStatus {
  PENDING
  PRESCRIPTION_CHECK
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PrescriptionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CLARIFICATION_NEEDED
}

enum ConsultationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum DeliveryStatus {
  PREPARING
  PACKED
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  NEARBY
  DELIVERED
  FAILED
  CANCELLED
}

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum NotificationType {
  ORDER
  PRESCRIPTION
  DELIVERY
  PROMOTION
  SYSTEM
  LOYALTY
}

// ============================================================
// CORE MODELS
// ============================================================

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  name          String
  passwordHash  String
  phone         String?
  avatarUrl     String?
  role          RoleName        @default(CUSTOMER)
  emailVerified DateTime?
  isActive      Boolean         @default(true)
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relationships
  addresses           Address[]
  orders              Order[]
  prescriptions       Prescription[]
  reviews             Review[]
  consultations       Consultation[]          @relation("PatientConsultations")
  doctorProfile       Doctor?
  auditLogs           AuditLog[]
  comments            Comment[]
  passwordResets      PasswordResetToken[]
  notifications       Notification[]
  loyaltyAccount      LoyaltyAccount?
  wishlistItems       Wishlist[]
  compareItems        CompareItem[]
  refreshTokens       RefreshToken[]
  branch              BranchStaff?
  deliveredOrders     DeliveryTracking[]      @relation("DriverDeliveries")
  assignedOrders      DeliveryTracking[]      @relation("AssignedDeliveries")
  cartItems           CartItem[]

  @@index([role])
  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  description String?
  permissions Permission[] @relation("RolePermissions")

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  description String?
  roles       Role[]   @relation("RolePermissions")

  @@map("permissions")
}

// ============================================================
// PRODUCT CATALOG
// ============================================================

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoUrl     String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("brands")
}

model Product {
  id                   String        @id @default(uuid())
  name                 String
  slug                 String        @unique
  sku                  String        @unique
  barcode              String?
  description          String
  price                Float
  compareAtPrice       Float?
  costPrice            Float?
  stockQuantity        Int           @default(0)
  minStockAlert        Int           @default(10)
  requiresPrescription Boolean       @default(false)
  isFeatured           Boolean       @default(false)
  isActive             Boolean       @default(true)
  dosageForm           String?
  strength             String?
  activeIngredients    String?
  usageInstructions    String?
  sideEffects          String?
  warnings             String?
  contraindications    String?
  pregnancyWarning     String?
  breastfeedingWarning String?
  ageRestriction       String?
  manufacturer         String?
  images               String[]
  rating               Float         @default(0)
  reviewCount          Int           @default(0)
  purchaseCount        Int           @default(0)
  tags                 String[]
  drugClass            String?

  categoryId           String
  category             Category      @relation(fields: [categoryId], references: [id])
  brandId              String?
  brand                Brand?        @relation(fields: [brandId], references: [id])

  orderItems           OrderItem[]
  prescriptionItems    PrescriptionItem[]
  reviews              Review[]
  wishlistItems        Wishlist[]
  compareItems         CompareItem[]
  batchExpiries        BatchExpiry[]
  branchInventory      BranchInventory[]
  cartItems            CartItem[]
  interactionsAsA      MedicineInteraction[] @relation("InteractionA")
  interactionsAsB      MedicineInteraction[] @relation("InteractionB")

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([price])
  @@index([stockQuantity])
  @@index([requiresPrescription])
  @@index([isFeatured])
  @@index([isActive])
  @@index([tags])
  @@index([drugClass])
  @@index([createdAt])
  @@map("products")
}

model BatchExpiry {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  branchId    String?
  branch      Branch?  @relation(fields: [branchId], references: [id])
  batchNumber String
  quantity    Int
  expiryDate  DateTime
  costPrice   Float?
  supplier    String?
  createdAt   DateTime @default(now())

  @@index([expiryDate])
  @@index([branchId])
  @@map("batch_expiries")
}

// ============================================================
// MULTI-BRANCH SYSTEM
// ============================================================

model Branch {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  code          String          @unique
  address       String
  city          String
  state         String
  country       String          @default("Ghana")
  latitude      Float?
  longitude     Float?
  phone         String
  email         String?
  isActive      Boolean         @default(true)
  isWarehouse   Boolean         @default(false)
  deliveryRadius Float          @default(10.0)
  operatingHours Json?
  holidaySchedule Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  staff         BranchStaff[]
  inventory     BranchInventory[]
  orders        Order[]
  batchExpiries BatchExpiry[]
  stockTransfersFrom StockTransfer[] @relation("TransferFrom")
  stockTransfersTo   StockTransfer[] @relation("TransferTo")
  deliveryTrackings DeliveryTracking[]
  analytics     BranchAnalytics[]

  @@index([slug])
  @@index([isActive])
  @@map("branches")
}

model BranchStaff {
  id        String      @id @default(uuid())
  userId    String      @unique
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id])
  position  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@map("branch_staff")
}

model BranchInventory {
  id              String   @id @default(uuid())
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  quantity        Int      @default(0)
  minStockAlert   Int      @default(5)
  lastRestockedAt DateTime?
  updatedAt       DateTime @updatedAt

  @@unique([branchId, productId])
  @@map("branch_inventory")
}

model StockTransfer {
  id              String         @id @default(uuid())
  fromBranchId    String
  fromBranch      Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranchId      String
  toBranch        Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  productId       String
  quantity        Int
  status          TransferStatus @default(PENDING)
  notes           String?
  requestedBy     String?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  @@index([fromBranchId])
  @@index([toBranchId])
  @@map("stock_transfers")
}

model BranchAnalytics {
  id          String   @id @default(uuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  date        DateTime
  revenue     Float    @default(0)
  orders      Int      @default(0)
  itemsSold   Int      @default(0)
  newCustomers Int    @default(0)
  createdAt   DateTime @default(now())

  @@unique([branchId, date])
  @@index([date])
  @@map("branch_analytics")
}

// ============================================================
// ORDERS & PAYMENTS
// ============================================================

model Address {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullAddress  String
  city         String
  state        String
  postalCode   String
  country      String   @default("Ghana")
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  label        String?
  createdAt    DateTime @default(now())

  orders       Order[]

  @@map("addresses")
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("cart_items")
}

model Order {
  id               String        @id @default(uuid())
  orderNumber      String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  branchId         String?
  branch           Branch?       @relation(fields: [branchId], references: [id])
  status           OrderStatus   @default(PENDING)
  totalAmount      Float
  shippingFee      Float         @default(0)
  taxAmount        Float         @default(0)
  discountAmount   Float         @default(0)
  couponCode       String?
  pickupInStore    Boolean       @default(false)
  estimatedDelivery DateTime?

  addressId        String?
  shippingAddress  Address?      @relation(fields: [addressId], references: [id])

  prescriptionId   String?
  prescription     Prescription? @relation(fields: [prescriptionId], references: [id])

  loyaltyPointsEarned Int       @default(0)
  loyaltyPointsUsed   Int       @default(0)

  orderItems       OrderItem[]
  payments         Payment[]
  deliveryTracking DeliveryTracking?

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([branchId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  total     Float

  @@map("order_items")
}

model Payment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  reference     String        @unique
  amount        Float
  currency      String        @default("GHS")
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  @@map("payments")
}

// ============================================================
// PRESCRIPTIONS
// ============================================================

model Prescription {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id])
  documentUrl     String
  patientNotes    String?
  pharmacistNote  String?
  doctorName      String?
  doctorLicense   String?
  prescribedDate  DateTime?
  expiryDate      DateTime?
  isVerified      Boolean            @default(false)
  status          PrescriptionStatus @default(SUBMITTED)
  priority        Int                @default(0)

  items           PrescriptionItem[]
  orders          Order[]
  verificationLogs PrescriptionVerificationLog[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([isVerified])
  @@index([createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  dosage         String
  frequency      String?
  duration       String?
  quantity       Int
  instructions   String?

  @@map("prescription_items")
}

model PrescriptionVerificationLog {
  id              String       @id @default(uuid())
  prescriptionId  String
  prescription    Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  action          String
  performedBy     String?
  notes           String?
  createdAt       DateTime     @default(now())

  @@index([prescriptionId])
  @@map("prescription_verification_logs")
}

// ============================================================
// CONSULTATIONS
// ============================================================

model Doctor {
  id            String         @id @default(uuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String
  qualification String
  licenseNumber String         @unique
  bio           String?
  consultFee    Float
  rating        Float          @default(5.0)
  isAvailable   Boolean        @default(true)
  availableHours Json?
  avatarUrl     String?

  consultations Consultation[] @relation("DoctorConsultations")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("doctors")
}

model Consultation {
  id             String             @id @default(uuid())
  patientId      String
  patient        User               @relation("PatientConsultations", fields: [patientId], references: [id])
  doctorId       String
  doctor         Doctor             @relation("DoctorConsultations", fields: [doctorId], references: [id])
  scheduledAt    DateTime
  duration       Int?
  status         ConsultationStatus @default(SCHEDULED)
  notes          String?
  diagnosis      String?
  prescription   String?
  meetingLink    String?
  createdAt      DateTime           @default(now())

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([scheduledAt])
  @@map("consultations")
}

// ============================================================
// MEDICINE INTERACTIONS
// ============================================================

model MedicineInteraction {
  id             String   @id @default(uuid())
  productAId     String
  productA       Product  @relation("InteractionA", fields: [productAId], references: [id])
  productBId     String
  productB       Product  @relation("InteractionB", fields: [productBId], references: [id])
  severity       String
  description    String
  recommendation String?
  reference      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([productAId, productBId])
  @@index([productAId])
  @@index([productBId])
  @@index([severity])
  @@map("medicine_interactions")
}

// ============================================================
// DELIVERY TRACKING
// ============================================================

model DeliveryTracking {
  id             String         @id @default(uuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  branchId       String?
  branch         Branch?        @relation(fields: [branchId], references: [id])
  driverId       String?
  driver         User?          @relation("DriverDeliveries", fields: [driverId], references: [id])
  assignedById   String?
  assignedBy     User?          @relation("AssignedDeliveries", fields: [assignedById], references: [id])
  status         DeliveryStatus @default(PREPARING)
  trackingNumber String         @unique
  estimatedTime  DateTime?
  actualDelivery DateTime?
  proofOfDelivery String?
  otpCode        String?
  deliveryNotes  String?
  currentLat     Float?
  currentLng    Float?

  statusHistory  DeliveryStatusLog[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@index([branchId])
  @@map("delivery_tracking")
}

model DeliveryStatusLog {
  id                String           @id @default(uuid())
  deliveryTrackingId String
  deliveryTracking  DeliveryTracking @relation(fields: [deliveryTrackingId], references: [id], onDelete: Cascade)
  status            DeliveryStatus
  notes             String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime         @default(now())

  @@index([deliveryTrackingId])
  @@map("delivery_status_logs")
}

// ============================================================
// LOYALTY & REWARDS
// ============================================================

model LoyaltyAccount {
  id              String      @id @default(uuid())
  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPoints     Int         @default(0)
  availablePoints Int         @default(0)
  tier            LoyaltyTier @default(BRONZE)
  totalSpent      Float       @default(0)
  referralCode    String      @unique
  referredBy      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  points          LoyaltyPoint[]
  redemptions     LoyaltyRedemption[]
  rewards         LoyaltyRewardClaim[]

  @@index([userId])
  @@index([referralCode])
  @@map("loyalty_accounts")
}

model LoyaltyPoint {
  id              String        @id @default(uuid())
  accountId       String
  account         LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  points          Int
  type            String
  description     String?
  orderId         String?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([accountId])
  @@index([type])
  @@map("loyalty_points")
}

model LoyaltyRedemption {
  id              String        @id @default(uuid())
  accountId       String
  account         LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pointsUsed      Int
  rewardType      String
  rewardValue     Float
  orderId         String?
  createdAt       DateTime      @default(now())

  @@index([accountId])
  @@map("loyalty_redemptions")
}

model LoyaltyRewardClaim {
  id              String        @id @default(uuid())
  accountId       String
  account         LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  rewardName      String
  rewardType      String
  rewardValue     Float
  claimedAt       DateTime      @default(now())

  @@index([accountId])
  @@map("loyalty_reward_claims")
}

// ============================================================
// COMPARE
// ============================================================

model CompareItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("compare_items")
}

// ============================================================
// WISHLIST
// ============================================================

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlists")
}

// ============================================================
// REVIEWS
// ============================================================

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  comment   String
  isVerified Boolean @default(false)
  helpful   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

// ============================================================
// COUPONS & PROMOTIONS
// ============================================================

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountPct    Float?
  discountAmount Float?
  maxDiscount    Float?
  minOrderAmount Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  validFrom      DateTime
  validUntil     DateTime
  isActive       Boolean   @default(true)
  appliesTo      String?
  createdAt      DateTime  @default(now())

  @@map("coupons")
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  position  String   @default("hero")
  validFrom DateTime?
  validUntil DateTime?
  createdAt DateTime @default(now())

  @@map("banners")
}

// ============================================================
// BLOG & CMS
// ============================================================

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String
  summary     String?
  author      String
  imageUrl    String?
  tags        String[]
  category    String?
  isPublished Boolean   @default(true)
  viewCount   Int       @default(0)
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model Comment {
  id         String    @id @default(uuid())
  blogPostId String
  blogPost   BlogPost  @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  parentId   String?
  parent     Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies    Comment[] @relation("CommentReplies")
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@map("comments")
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("faqs")
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String?
  content     String
  rating      Int?
  imageUrl    String?
  isApproved  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@map("testimonials")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

// ============================================================
// AUDIT & SETTINGS
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
  type  String @default("string")

  @@map("system_settings")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

// ============================================================
// JUMARALD AI PLATFORM MODELS
// ============================================================

enum AIConversationChannel {
  WEB_WIDGET
  WEB_FULLSCREEN
  MOBILE_APP
  PHARMACIST_COPILOT
}

enum AISafetyRiskLevel {
  LOW
  MODERATE
  HIGH
  EMERGENCY
}

enum AIEscalationStatus {
  OPEN
  ASSIGNED
  RESOLVED
}

enum AIKnowledgeStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

model AIConversation {
  id          String                @id @default(uuid())
  userId      String?
  channel     AIConversationChannel @default(WEB_WIDGET)
  title       String?
  isArchived  Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  messages    AIMessage[]
  escalations AIEscalation[]

  @@index([userId])
  @@index([createdAt])
  @@map("ai_conversations")
}

model AIMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AIConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String            // user | assistant | system | tool
  content        String
  intent         String?
  riskLevel      AISafetyRiskLevel @default(LOW)
  toolCallsJson  String?           // Executed tool logs
  citationsJson  String?           // Grounded RAG sources
  createdAt      DateTime          @default(now())

  toolCalls      AIToolCall[]
  feedbacks      AIFeedback[]

  @@index([conversationId])
  @@index([createdAt])
  @@map("ai_messages")
}

model AIToolCall {
  id              String    @id @default(uuid())
  messageId       String
  message         AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  toolName        String
  inputJson       String
  outputJson      String?
  executionTimeMs Int       @default(0)
  status          String    @default("SUCCESS") // SUCCESS | FAILED | BLOCKED
  createdAt       DateTime  @default(now())

  @@index([messageId])
  @@index([toolName])
  @@map("ai_tool_calls")
}

model AIEscalation {
  id                   String             @id @default(uuid())
  conversationId       String
  conversation         AIConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId               String?
  reason               String
  severity             AISafetyRiskLevel  @default(HIGH)
  summary              String
  status               AIEscalationStatus @default(OPEN)
  assignedPharmacistId String?
  pharmacistNotes      String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([conversationId])
  @@index([status])
  @@index([severity])
  @@map("ai_escalations")
}

model AIKnowledgeDocument {
  id          String            @id @default(uuid())
  title       String
  source      String
  category    String            @default("Clinical Guidelines")
  status      AIKnowledgeStatus @default(APPROVED)
  content     String
  version     Int               @default(1)
  approvedBy  String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  chunks      AIKnowledgeChunk[]

  @@index([category])
  @@index([status])
  @@map("ai_knowledge_documents")
}

model AIKnowledgeChunk {
  id            String              @id @default(uuid())
  documentId    String
  document      AIKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex    Int
  content       String
  metadataJson  String?
  embeddings    Float[]
  createdAt     DateTime            @default(now())

  @@index([documentId])
  @@map("ai_knowledge_chunks")
}

model AIFeedback {
  id        String    @id @default(uuid())
  messageId String
  message   AIMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String?
  isHelpful Boolean
  comment   String?
  createdAt DateTime  @default(now())

  @@index([messageId])
  @@map("ai_feedbacks")
}

model AISafetyEvent {
  id             String            @id @default(uuid())
  conversationId String?
  userId         String?
  eventCategory  String            // EMERGENCY_SYMPTOM | UNSAFE_DOSAGE | PROMPT_INJECTION
  inputSnippet   String
  riskLevel      AISafetyRiskLevel @default(HIGH)
  actionTaken    String            // ESCALATED | REFUSED | WARNED
  createdAt      DateTime          @default(now())

  @@index([eventCategory])
  @@index([createdAt])
  @@map("ai_safety_events")
}

