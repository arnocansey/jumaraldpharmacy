# ============================================
# JUMARALD PHARMACY - Environment Variables
# ============================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] must be set for the app to work.
# Variables marked [OPTIONAL] enable extra features when set.
# ============================================


# --------------------------------------------
# BACKEND (.env in /backend)
# --------------------------------------------

# [REQUIRED] Server
PORT=5000
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# [REQUIRED] Database (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@ep-xxx-region.aws.neon.tech/jumarald_db?sslmode=require

# [REQUIRED] CORS - comma-separated allowed origins
ALLOWED_ORIGINS=https://jumaraldpharmacy.vercel.app,https://jumaraldpharmacyadmin.vercel.app

# [REQUIRED] Frontend URLs (for email links, payment callbacks)
FRONTEND_URL=https://jumaraldpharmacy.vercel.app
ADMIN_URL=https://jumaraldpharmacyadmin.vercel.app


# [OPTIONAL] Paystack - Payment processing
# Sign up: https://paystack.com
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxx


# [OPTIONAL] Cloudinary - Image uploads
# Sign up: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# [OPTIONAL] SMTP - Transactional emails
# Use Gmail, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@jumaraldpharmacy.com


# [OPTIONAL] Redis - Caching & rate limiting
# Free tier: https://upstash.com or https://redis.com
# Format: redis://default:password@host:port
REDIS_URL=redis://default:xxxxxxxxxxxx@xxxxxx.upstash.io:6379


# [OPTIONAL] Sentry - Error monitoring + profiling
# Free tier: https://sentry.io
SENTRY_DSN=https://cf193055468769489d4a988151f92832@o4511868506996736.ingest.de.sentry.io/4511868515254352


# [OPTIONAL] Africa's Talking - SMS notifications (Ghana)
# Sign up: https://africastalking.com
AFRICASTALKING_API_KEY=your-api-key
AFRICASTALKING_USERNAME=your-username
AFRICASTALKING_SENDER_ID=JUMARALD


# [OPTIONAL] SendGrid - Email marketing / newsletters
# Free tier: https://sendgrid.com
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_LIST_ID=your-list-id
SENDGRID_FROM_EMAIL=noreply@jumaraldpharmacy.com


# [OPTIONAL] Mailchimp - Email marketing (alternative to SendGrid)
# Free tier: https://mailchimp.com
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx-usXX
MAILCHIMP_LIST_ID=your-list-id


# [OPTIONAL] Web Push Notifications (VAPID keys)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --------------------------------------------
# FRONTEND (.env.local in /frontend)
# --------------------------------------------

# [REQUIRED] Backend API URL
NEXT_PUBLIC_API_URL=https://jumaraldpharmacy.onrender.com/api/v1

# [OPTIONAL] Supabase (unused, legacy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# --------------------------------------------
# ADMIN (.env.local in /admin)
# --------------------------------------------

# [REQUIRED] Backend API URL
NEXT_PUBLIC_API_URL=https://jumaraldpharmacy.onrender.com/api/v1

# [OPTIONAL] Supabase (unused, legacy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# --------------------------------------------
# VERCEL (set in Vercel dashboard, not in .env)
# --------------------------------------------

# These are set in the Vercel project settings under Environment Variables.
# Do NOT put them in .env files committed to git.

# FRONTEND project:
#   NEXT_PUBLIC_API_URL = https://jumaraldpharmacy.onrender.com/api/v1

# ADMIN project:
#   NEXT_PUBLIC_API_URL = https://jumaraldpharmacy.onrender.com/api/v1


# --------------------------------------------
# RENDER (set in Render dashboard, not in .env)
# --------------------------------------------

# These are set in the Render service settings under Environment Variables.
# Do NOT put them in .env files committed to git.

# All backend env vars above should be set here.
# For production, use the LIVE Paystack keys, not test keys.


# --------------------------------------------
# GITHUB ACTIONS (set in repo secrets)
# --------------------------------------------

# These are set in GitHub repo Settings > Secrets and variables > Actions.

# RENDER_DEPLOY_HOOK = https://api.render.com/deploy/srv-xxxxx
# VERCEL_FRONTEND_DEPLOY_HOOK = https://api.vercel.com/v1/integrations/deploy/prj_xxxxx
# VERCEL_ADMIN_DEPLOY_HOOK = https://api.vercel.com/v1/integrations/deploy/prj_xxxxx


# --------------------------------------------
# QUICK START
# --------------------------------------------
#
# 1. Clone the repo
# 2. Copy this file to .env in the backend folder
# 3. Fill in DATABASE_URL and JWT_SECRET (minimum)
# 4. Run: cd backend && npm install && npx prisma db push
# 5. Run: npm run dev (starts backend on :5000)
# 6. In another terminal: cd frontend && npm install && npm run dev (starts on :3000)
# 7. In another terminal: cd admin && npm install && npm run dev (starts on :3001)
#
# For production deployment, see DEPLOY.md
